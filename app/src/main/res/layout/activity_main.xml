<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:keepScreenOn="true">

    <!-- Camera Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cockpit HUD Overlay -->
    <LinearLayout
        android:id="@+id/layoutHud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Telemetry Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="#70000000">

            <!-- Recording Indicator -->
            <TextView
                android:id="@+id/tvRecIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 REC"
                android:textColor="@color/dash_red"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 00:00"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:layout_marginStart="8dp" />

            <!-- Compass Heading -->
            <TextView
                android:id="@+id/tvHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="N 000°"
                android:textColor="@color/dash_cyan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center" />

            <!-- Timestamp Watermark -->
            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-11-24 17:50:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Center Telemetry Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left: Digital Speedometer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#70000000">

                <TextView
                    android:id="@+id/tvSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:textColor="@color/dash_green"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KM/H SPEED"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Right: G-Sensor Telemetry -->
            <LinearLayout
                android:id="@+id/layoutGCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#70000000">

                <TextView
                    android:id="@+id/tvGForceTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.00 G"
                    android:textColor="@color/dash_cyan"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvGForceAxes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lat: 0.00G | Long: 0.00G"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvImpactStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHOCK SENSOR: ARMED (2.2G)"
                    android:textColor="@color/dash_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Cockpit Control Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLockIncident"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="🚨 LOCK CLIP"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/dash_red"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvLockedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Locked Incidents: 0 clips"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="#70000000"
                android:padding="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMasterRecord"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="PAUSE DASHCAM"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/dash_bg"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/dash_cyan"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
